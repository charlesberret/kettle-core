# House local surface — never publish.
.local/
.inbox/
.coordination/
.claude/
.cursor/
.grok/
.aider*
.worktrees/

# Secrets
.env
.env.*
!.env.example
*.pem
*.key

# Python
__pycache__/
*.py[cod]
*.egg
*.egg-info/
build/
dist/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.json
coverage.xml
htmlcov/

# Node (occasional tooling; the runtime stays stdlib)
node_modules/
uv.lock
*.tsbuildinfo
.turbo/
.cache/

# OS
.DS_Store
.AppleDouble
.LSOverride
Thumbs.db
*~
*.swp
*.swo
*.bak
*SFConflict*

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json.example
*.code-workspace
*.sublime-project
*.sublime-workspace

# Logs. The sitting-judge fixtures ship a synthetic approvals log on purpose.
*.log
!tools/judge/fixtures/**/*.log

# Per-project desk state.
# kettle creates <project-root>/.kettle/ for each project's curator desk: the queue,
# chat transcript, snapshots, sessions, and logs. It is per-user runtime, never committed.
# The repo's own development desk lives here too and must stay local.
.kettle/

# Synthetic desks shipped with the sitting judge. A live project desk stays ignored.
!tools/judge/fixtures/**/.kettle/
!tools/judge/fixtures/**/.kettle/**

# Personal config (both self-create on first run; see projects.example.json)
projects.json
settings.json

# Ollama persona pack (local forever).
# Trial / host-local install, skills, eval prompts, and install.sh.
# Not product surface.
ollama/

# Curator packs until a pack is actually ready to publish.
# Remove this block when curators/ is product surface.
curators/

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
